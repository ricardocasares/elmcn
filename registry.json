    {
      "name": "theme",
      "type": "registry:item",
      "title": "Theme",
      "description": "shadcn/ui neutral color tokens, radius and dark mode for Tailwind CSS v4. Import it after tailwindcss in your stylesheet.",
      "docs": "Add `@import \"./elmcn.css\";` after `@import \"tailwindcss\";` in your main stylesheet.",
      "files": [
        {
          "path": "src/elmcn.css",
          "type": "registry:file",
          "target": "~/src/elmcn.css"
        }
      ]
    },
    {

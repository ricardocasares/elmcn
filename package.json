{
  "name": "elmcn",
  "private": true,
  "type": "module",
  "description": "shadcn/ui components for Elm, distributed as a shadcn registry",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "bun run docs:gen && vite build",
    "preview": "vite preview",
    "docs:gen": "bun scripts/gen-docs.ts",
    "format": "elm-format src docs --yes",
    "check": "bun run docs:gen && tsc -p . && elm-format src docs --validate && elm-review && shadcn registry validate && bun scripts/check-registry.ts",
    "test:install": "bun scripts/install-test.ts",
    "postinstall": "elm-tooling install",
    "prepare": "husky",
    "review": "elm-review"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.2",
    "elm-review": "^2.13.5",
    "elm-tooling": "^1.21.0",
    "husky": "^9.1.7",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-elm": "^3.0.1"
  }
}
